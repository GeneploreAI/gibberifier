{
  "manifest_version": 3,
  "name": "Gibberifier",
  "version": "2.0.0",
  "description": "Right-click selected text to convert it into gibberish using invisible Unicode characters",
  "permissions": [
    "activeTab",
    "clipboardRead",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["dist/gibberify-core.js", "dist/content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
