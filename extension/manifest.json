{
  "manifest_version": 3,
  "name": "Gibberifier",
  "version": "1.0.0",
  "description": "Right-click selected text or press Alt+G to convert it into gibberish using invisible Unicode characters",
  "permissions": [
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
